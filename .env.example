SECRET_KEY=replace-with-a-strong-random-secret
DEBUG=False

ALLOWED_HOSTS=api.yourdomain.com
CSRF_TRUSTED_ORIGINS=https://api.yourdomain.com
CORS_ALLOWED_ORIGINS=https://www.yourfrontend.com

TIME_ZONE=Asia/Dhaka
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# Redis/Celery toggle
USE_REDIS=False
CELERY_TASK_ALWAYS_EAGER=True

# Database configuration
# Option 1: Use DATABASE_URL (if set, this takes priority)
DATABASE_URL=

# Option 2: Use separate DB credentials (recommended for Coolify forms)
DB_ENGINE=django.db.backends.mysql
DB_NAME=admin_ec
DB_USER=admin_user
DB_PASSWORD=replace-with-db-password
DB_HOST=mysql-service
DB_PORT=3306

# Optional Redis/Celery settings (only needed if USE_REDIS=True)
REDIS_URL=redis://redis-service:6379/0
CELERY_BROKER_URL=redis://redis-service:6379/0
CELERY_RESULT_BACKEND=redis://redis-service:6379/1

STEADFAST_API_BASE_URL=https://portal.packzy.com/api/v1
STEADFAST_API_KEY=your_api_key
STEADFAST_SECRET_KEY=your_secret_key

VERIFICATION_API_BASE_URL=https://vocabadmin.englishcommando.bd/api
